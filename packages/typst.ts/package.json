{
  "name": "@leandown/typst.ts",
  "version": "0.0.22",
  "description": "A WebAssembly build of typst.ts that compiles Typst projects to multi-page HTML (Typst's bundle target), for Node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzhang28/leandown.git",
    "directory": "packages/typst.ts"
  },
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wasm/typst_ts_web_compiler.js",
    "wasm/typst_ts_web_compiler_bg.wasm",
    "wasm/typst_ts_web_compiler.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "prepack": "test -f wasm/typst_ts_web_compiler_bg.wasm || bash scripts/build.sh"
  },
  "publishConfig": {
    "access": "public"
  }
}
