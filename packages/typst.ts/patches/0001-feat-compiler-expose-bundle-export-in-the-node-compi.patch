+
+    /// Compiles the document as a bundle: several documents and assets from
+    /// one project, as declared with `document` and `asset`.
+    #[napi]
+    #[cfg(feature = "bundle")]
+    pub fn bundle(&mut self, opts: CompileDocArgs) -> NodeBundleExecResult {
+        let res = self.compile_bundle(opts);
+        ExecResultRepr::from_result(res).into()
+    }
+
+    #[cfg(feature = "bundle")]
+    fn compile_bundle(
+        &mut self,
+        opts: CompileDocArgs,
+    ) -> std::result::Result<ExecResultRepr<NodeBundleOutput>, NodeError> {
+        use reflexo_typst::typst::LazyHash;
+        use typst::{Feature, Features, Library, LibraryExt};
+        use typst_bundle::{Bundle, BundleOptions};
+
+        let graph = self.driver.assert_mut().computation(opts)?;
+
+        // The bundle target needs the html and bundle features in the library,
+        // which the shared world doesn't enable.
+        let mut world = graph.snap.world.clone();
+        let features: Features = [Feature::Html, Feature::Bundle].into_iter().collect();
+        let library = Library::builder()
+            .with_inputs(world.inputs().as_ref().deref().clone())
+            .with_features(features)
+            .build();
+        world.library = Arc::new(LazyHash::new(library));
+
+        let compiled: ExecResultRepr<Bundle> = typst::compile::<Bundle>(&world).into();
+        let res = compiled.and_then(|bundle| {
+            let fs = typst_bundle::export(&bundle, &BundleOptions::default())?;
+            let files = fs
+                .into_iter()
+                .map(|(path, bytes)| (path.get_without_slash().to_owned(), bytes))
+                .collect();
+            Ok(NodeBundleOutput {
+                files: Arc::new(files),
+            })
+        });
+        Ok(res.with_graph(graph))
+    }
 }
 
 #[napi]
