+/// A file emitted by a bundle compilation.
+#[napi(object)]
+pub struct NodeBundleFile {
+    /// The path of the file within the bundle, without a leading slash.
+    pub path: String,
+    /// The file's content.
+    pub content: Buffer,
+}
+
+/// The files emitted by a bundle compilation.
+#[napi]
+#[derive(Clone)]
+pub struct NodeBundleOutput {
+    pub(crate) files: Arc<Vec<(String, reflexo_typst::Bytes)>>,
+}
+
+#[napi]
+impl NodeBundleOutput {
+    /// Gets the paths of the emitted files, in output order.
+    #[napi]
+    pub fn paths(&self) -> Vec<String> {
+        self.files.iter().map(|(path, _)| path.clone()).collect()
+    }
+
+    /// Gets the emitted files.
+    #[napi]
+    pub fn files(&self) -> Vec<NodeBundleFile> {
+        self.files
+            .iter()
+            .map(|(path, content)| NodeBundleFile {
+                path: path.clone(),
+                content: content.as_slice().into(),
+            })
+            .collect()
+    }
+}
+
 /// A shared HTML output object.
 #[napi]
 #[derive(Clone)]
