diff --git a/packages/compiler/src/lib.rs b/packages/compiler/src/lib.rs
index a672ab1..2d24c9f 100644
--- a/packages/compiler/src/lib.rs
+++ b/packages/compiler/src/lib.rs
@@ -358,6 +358,64 @@ impl TypstCompiler {
         w.query(0, selector, field)
     }
 
+    /// Compiles the project for Typst's bundle target: several documents and
+    /// assets from one project, as declared with `document` and `asset`.
+    ///
+    /// Returns `{ files, hasError, diagnostics }`, where `files` is an array of
+    /// `{ path, content }` (`content` a `Uint8Array`) when compilation succeeds.
+    #[cfg(feature = "bundle")]
+    pub fn bundle(
+        &mut self,
+        root: Option<String>,
+        main_file_path: String,
+        inputs: Option<Vec<js_sys::Array>>,
+        diagnostics_format: u8,
+    ) -> Result<JsValue, JsValue> {
+        use ::typst::{Feature, Features, Library, LibraryExt};
+        use std::ops::Deref;
+        use typst_bundle::{Bundle, BundleOptions};
+
+        let w = self.snapshot(root, Some(main_file_path), inputs)?;
+
+        // The bundle target needs the html and bundle features in the library,
+        // which the shared world doesn't enable.
+        let mut world = w.graph.snap.world.clone();
+        let features: Features = [Feature::Html, Feature::Bundle].into_iter().collect();
+        let library = Library::builder()
+            .with_inputs(world.inputs().as_ref().deref().clone())
+            .with_features(features)
+            .build();
+        world.library = Arc::new(LazyHash::new(library));
+
+        let Warned { output, warnings } = ::typst::compile::<Bundle>(&world);
+        let exported = output.and_then(|bundle| typst_bundle::export(&bundle, &BundleOptions::default()));
+
+        match exported {
+            Ok(fs) => {
+                let res = convert_diag(warnings.iter(), Some(&world), false, diagnostics_format);
+                let files = Array::new();
+                for (path, bytes) in fs {
+                    let file = js_sys::Object::new();
+                    js_sys::Reflect::set(&file, &"path".into(), &path.get_without_slash().into())?;
+                    js_sys::Reflect::set(
+                        &file,
+                        &"content".into(),
+                        &Uint8Array::from(bytes.as_slice()).into(),
+                    )?;
+                    files.push(&file);
+                }
+                js_sys::Reflect::set(&res, &"files".into(), &files.into())?;
+                Ok(res)
+            }
+            Err(errors) => Ok(convert_diag(
+                warnings.iter().chain(errors.iter()),
+                Some(&world),
+                true,
+                diagnostics_format,
+            )),
+        }
+    }
+
     #[cfg(feature = "incr")]
     pub fn create_incr_server(&mut self) -> Result<IncrServer, JsValue> {
         Ok(IncrServer::default())
