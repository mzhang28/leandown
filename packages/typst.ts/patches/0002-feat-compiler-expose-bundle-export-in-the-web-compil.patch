index d26e794..22c8289 100644
--- a/packages/compiler/Cargo.toml
+++ b/packages/compiler/Cargo.toml
@@ -41,6 +41,7 @@ reflexo-typst = { workspace = true, features = ["web"] }
 reflexo-vec2svg.workspace = true
 typst.workspace = true
 typst-assets = { workspace = true, optional = true }
+typst-bundle = { workspace = true, optional = true }
 
