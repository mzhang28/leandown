From b1f34d28bca813dce5e68a0a5e5e8ecc6484e9c5 Mon Sep 17 00:00:00 2001
From: Michael Zhang <mail@mzhang.io>
Date: Sun, 11 Oct 2026 19:28:47 -0400
Subject: [PATCH] feat(compiler): expose bundle export in the web compiler

Adds TypstCompiler.bundle(), which compiles the project for Typst's bundle
target and returns the exported files with diagnostics. Behind the
`bundle` feature.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 Cargo.lock                   |  1 +
 packages/compiler/Cargo.toml |  2 ++
 packages/compiler/src/lib.rs | 58 ++++++++++++++++++++++++++++++++++++
 3 files changed, 61 insertions(+)

diff --git a/Cargo.lock b/Cargo.lock
index 97a2843..cdd4d34 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5814,6 +5814,7 @@ dependencies = [
  "sha2",
  "typst",
  "typst-assets",
