{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "composite": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/template",
    "src/**/*.test.ts",
    "src/**/__fixtures__",
    "src/assets"
  ],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    }
  ]
}
