{
  "name": "@leandown/markdown-it",
  "version": "0.0.22",
  "description": "markdown-it plugin for syntax-highlighting Lean 4 code blocks via the Lean LSP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzhang28/leandown.git",
    "directory": "packages/markdown-it"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "bun run build",
    "build": "bun run build:js && bun run build:dts",
    "build:js": "bun build src/index.ts --outdir dist --format esm --target node --external @leandown/core --external markdown-it",
    "build:dts": "tsc -b tsconfig.build.json"
  },
  "type": "module",
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "markdown-it": ">=13.0.0"
  },
  "dependencies": {
    "@leandown/core": "0.0.22"
  },
  "publishConfig": {
    "access": "public"
  }
}
